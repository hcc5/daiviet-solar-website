# Copy file này thành .env khi tạo stack trong Portainer (hoặc điền trực tiếp
# vào phần "Environment variables" của Stack trong Portainer UI).

MYSQL_DATABASE=daiviet_solar
MYSQL_USER=daiviet_solar
MYSQL_PASSWORD=doi_mat_khau_manh_o_day
MYSQL_ROOT_PASSWORD=doi_mat_khau_root_manh_o_day

# Domain thật sẽ dùng để publish site (ví dụ: https://daivietsolar.example.vn)
# Nếu chỉ review tạm bằng IP:port thì để dạng http://IP:PORT trùng với WP_PUBLISH_PORT bên dưới.
WP_HOME=http://localhost:8090

# Port sẽ publish ra ngoài để review trực tiếp bằng IP (nếu chưa gắn domain qua NPM)
WP_PUBLISH_PORT=8090
